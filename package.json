{
	"name": "rust-ps-snippets",
	"author": {
		"name": "kiwiyou",
		"email": "kiwiyou@kiwiyou.dev"
	},
	"description": "Blank project with routing included",
	"engines": {
		"node": ">=25"
	},
	"packageManager": "pnpm@10.26.2",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "qwik build",
		"build.client": "vite build",
		"build.preview": "vite build --ssr src/entry.preview.tsx",
		"build.types": "tsc --incremental --noEmit",
		"deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
		"dev": "vite --mode ssr",
		"dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
		"fmt": "prettier --write .",
		"fmt.check": "prettier --check .",
		"lint": "NODE_OPTIONS=--experimental-strip-types eslint \"src/**/*.ts*\" --flag unstable_native_nodejs_ts_config",
		"prebuild.pandacss": "panda codegen --silent",
		"preview": "qwik build preview && vite preview --open",
		"start": "vite --open --mode ssr",
		"qwik": "qwik"
	},
	"devDependencies": {
		"@builder.io/qwik": "^1.18.0",
		"@builder.io/qwik-city": "^1.18.0",
		"@builder.io/vite-plugin-macro": "~0.0.7",
		"@eslint/js": "latest",
		"@pandacss/dev": "^0.54.0",
		"@qwik-ui/headless": "^0.7.4",
		"@types/node": "^25.0.3",
		"eslint": "^9.39.2",
		"eslint-plugin-qwik": "^1.18.0",
		"globals": "^16.5.0",
		"iconify-icon": "^3.0.2",
		"pandacss-preset-typography": "^0.1.6",
		"prettier": "^3.7.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.51.0",
		"typescript-plugin-css-modules": "latest",
		"undici": "^7.16.0",
		"vite": "7.2.6",
		"vite-tsconfig-paths": "^4.3.2"
	}
}
